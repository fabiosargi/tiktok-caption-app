<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#111111"
      android:padding="24dp">

      <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#00000000"
                android:contentDescription="Configurações"
                android:src="@android:drawable/ic_menu_manage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

      <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Último vídeo da galeria"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/btnSettings"
                app:layout_constraintStart_toStartOf="parent" />

      <TextView
                android:id="@+id/videoInfoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nenhum vídeo encontrado ainda"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/titleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

      <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Atualizar (buscar vídeo mais recente)"
                app:layout_constraintTop_toBottomOf="@id/videoInfoText"
                app:layout_constraintStart_toStartOf="parent" />

      <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/btnRefresh"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

      <LinearLayout
                android:id="@+id/postButtonsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@id/btnPublish">

                <Button
                              android:id="@+id/btnPostTikTok"
                              android:layout_width="0dp"
                              android:layout_height="wrap_content"
                              android:layout_weight="1"
                              android:layout_marginEnd="4dp"
                              android:text="TikTok"
                              android:visibility="gone" />

                <Button
                              android:id="@+id/btnPostInstagram"
                              android:layout_width="0dp"
                              android:layout_height="wrap_content"
                              android:layout_weight="1"
                              android:layout_marginHorizontal="4dp"
                              android:text="Instagram"
                              android:visibility="gone" />

                <Button
                              android:id="@+id/btnPostYouTube"
                              android:layout_width="0dp"
                              android:layout_height="wrap_content"
                              android:layout_weight="1"
                              android:layout_marginStart="4dp"
                              android:text="YouTube"
                              android:visibility="gone" />

      </LinearLayout>

      <Button
                android:id="@+id/btnPublish"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="24dp"
                android:text="Gerar legenda com IA"
                android:textSize="18sp"
                android:backgroundTint="#E53935"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
