<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="24dp">

      <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chave de API do Gemini (Google AI Studio)"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

      <EditText
                android:id="@+id/editApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Cole sua chave aqui" />

      <Button
                android:id="@+id/btnSaveKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Salvar" />

      <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Permissão de Acessibilidade"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

      <Button
                android:id="@+id/btnOpenAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abrir configurações de Acessibilidade" />

</LinearLayout>
